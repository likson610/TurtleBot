<?xml version="1.0"?>
<!-- New local test world. No online Fuel resources are required. Units: metres. -->
<sdf version="1.9">
  <world name="default">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.7 0.7 1</background></scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular><direction>-0.3 0.2 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="floor">
      <static>true</static><link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 8</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 8</size></plane></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="north_wall"><static>true</static><pose>0 3 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>8.2 0.15 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>8.2 0.15 1</size></box></geometry></visual>
    </link></model>
    <model name="south_wall"><static>true</static><pose>0 -3 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>8.2 0.15 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>8.2 0.15 1</size></box></geometry></visual>
    </link></model>
    <model name="east_wall"><static>true</static><pose>4 0 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.15 6 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.15 6 1</size></box></geometry></visual>
    </link></model>
    <model name="west_wall"><static>true</static><pose>-4 0 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.15 6 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.15 6 1</size></box></geometry></visual>
    </link></model>
    <model name="box"><static>true</static><pose>1.5 0.7 0.3 0 0 0.3</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.8 0.6 0.6</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 0.6 0.6</size></box></geometry>
        <material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.2 0.4 0.7 1</diffuse></material>
      </visual>
    </link></model>
    <model name="partition"><static>true</static><pose>-1.8 -0.7 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.15 2 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.15 2 1</size></box></geometry></visual>
    </link></model>
  </world>
</sdf>
